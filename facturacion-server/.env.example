APP_NAME="Facturacion Refugio Rocca"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://facturacion.refugioagostinorocca.com
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Separe varias claves con comas durante una rotacion. Use al menos 32 caracteres.
BILLING_API_KEYS=
SETTINGS_USERNAME=facturacion
SETTINGS_PASSWORD=
BILLING_BCC_EMAILS=

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=facturacion
DB_USERNAME=facturacion
DB_PASSWORD=
DB_ROOT_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=facturacion@refugioagostinorocca.com
MAIL_FROM_NAME="Refugio Agostino Rocca"

ARCA_ENVIRONMENT=production
ARCA_WSAA_URL=https://wsaa.afip.gov.ar/ws/services/LoginCms
ARCA_WSFE_WSDL=https://servicios1.afip.gov.ar/wsfev1/service.asmx?WSDL
ARCA_TA_RENEW_BEFORE_MINUTES=10

